# ──────────────────────────────────────────────────────────────────────────────
# GEM CYBER – Environment Variable Reference
# Copy this file to .env.local (never commit .env.local or .env.production)
# ──────────────────────────────────────────────────────────────────────────────

# ── Public / Client-side ──────────────────────────────────────────────────────
# Displayed in UI and metadata; safe to expose to the browser.
NEXT_PUBLIC_APP_NAME=GEM CYBER
NEXT_PUBLIC_SUPPORT_EMAIL=admin@gemcybersecurityassist.com
NEXT_PUBLIC_SUPPORT_PHONE=(860) 305-4376

# ── Database (REQUIRED for all DB-backed features) ────────────────────────────
# PostgreSQL connection string. Compatible with any Postgres provider:
#   Neon:            postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
#   Vercel Postgres: postgres://user:pass@ep-xxx.us-east-1.aws.neon.tech/verceldb?sslmode=require
#   Supabase:        postgres://postgres:pass@db.xxx.supabase.co:5432/postgres
#   Railway:         postgres://postgres:pass@roundhouse.proxy.rlwy.net:PORT/railway
#
# After setting this variable, run:  npm run db:migrate
DATABASE_URL=

# ── Admin Authentication ───────────────────────────────────────────────────────
# HMAC secret used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production — deployment will be insecure without this.
ADMIN_AUTH_SECRET=change-me-use-a-long-random-secret

# Seed passwords for the three default admin accounts (used by npm run db:migrate
# only when the admin_users table is empty). Set before first migration; rotate after.
SUPER_ADMIN_PASSWORD=change-me-superadmin
ADMIN_PASSWORD=change-me-admin
ANALYST_PASSWORD=change-me-analyst

# ── SMTP / Transactional Email ─────────────────────────────────────────────────
# Used by /api/contact to email intake notifications.
# If left blank, contact submissions are saved to the DB but no email is sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-app-password

# ── External Integrations (optional) ─────────────────────────────────────────
# Leave blank to disable; the app degrades gracefully when these are missing.
DATA_PROVIDER_API_KEY=
NEWS_INGESTION_WEBHOOK_SECRET=
EMAIL_PROVIDER_API_KEY=
EMAIL_SENDING_DOMAIN=

# ── Observability ─────────────────────────────────────────────────────────────
AUDIT_LOG_SINK=
