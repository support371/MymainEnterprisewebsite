# ──────────────────────────────────────────────────────────────────────────────
# GEM CYBER – Environment Variable Reference
# Copy this file to .env.local (never commit .env.local or .env.production)
# ──────────────────────────────────────────────────────────────────────────────

# ── Public / Client-side ──────────────────────────────────────────────────────
# Displayed in UI and metadata; safe to expose to the browser.
NEXT_PUBLIC_APP_NAME=GEM CYBER
NEXT_PUBLIC_SUPPORT_EMAIL=admin@gemcybersecurityassist.com
NEXT_PUBLIC_SUPPORT_PHONE=(860) 305-4376

# ── Admin Authentication ───────────────────────────────────────────────────────
# HMAC secret used to sign session tokens — use a long random string in prod.
ADMIN_AUTH_SECRET=change-me-use-a-long-random-secret

# Default passwords for seeded admin accounts (used only when data/admin-users.json
# does not yet exist). Override before first deployment; rotate immediately after.
SUPER_ADMIN_PASSWORD=change-me-superadmin
ADMIN_PASSWORD=change-me-admin
ANALYST_PASSWORD=change-me-analyst

# ── SMTP / Transactional Email ─────────────────────────────────────────────────
# Used by /api/contact to send intake notifications.
# If left blank, emails are skipped and submissions are still saved locally.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-app-password

# ── External Integrations (optional) ─────────────────────────────────────────
# Leave blank to disable; the app degrades gracefully for missing keys.
DATA_PROVIDER_API_KEY=
NEWS_INGESTION_WEBHOOK_SECRET=
EMAIL_PROVIDER_API_KEY=
EMAIL_SENDING_DOMAIN=

# ── Data / Storage ────────────────────────────────────────────────────────────
# Future: replace file-based JSON store with a real database.
DATABASE_URL=

# ── Observability ─────────────────────────────────────────────────────────────
AUDIT_LOG_SINK=
